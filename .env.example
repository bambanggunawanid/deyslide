# Copy to .env (never committed). No quotes around values.
# The deploy workflow sets CLOUDFLARE_TUNNEL_TOKEN from the GitHub secret on every deploy,
# and makes the other two on the first deploy if they are missing.
# The tunnel token: Cloudflare Zero Trust > Networks > Tunnels > the tunnel > the value after --token.
CLOUDFLARE_TUNNEL_TOKEN=
# Set once and kept: the database stores its password on first start, and a new auth secret signs everyone out.
# Make each with: openssl rand -hex 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
