# `vite build --mode app` (and `vite --mode app`): the pages the Deyslide app
# in apps/native shows. See src/platform/platform.ts.
VITE_APP=1
# The server the app talks to unless its settings name another (the app's
# app_info command says which one at startup).
VITE_SERVER_URL=https://deyslide.bambanggunawan.id
