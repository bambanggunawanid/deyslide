{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Deyslide",
  "identifier": "id.bambanggunawan.deyslide",
  "build": {
    "frontendDist": "../../web/dist-app",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "pnpm animations:build && pnpm --filter @deyslide/web dev:app",
      "cwd": "../.."
    },
    "beforeBuildCommand": {
      "script": "pnpm animations:build && pnpm --filter @deyslide/web build:app",
      "cwd": "../.."
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Deyslide",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 640,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "app", "dmg"],
    "publisher": "bambanggunawanid",
    "homepage": "https://deyslide.bambanggunawan.id",
    "copyright": "MIT License, bambanggunawanid",
    "category": "Productivity",
    "shortDescription": "Presentations for live teaching and cinematic talks",
    "longDescription": "Deyslide makes Slidev presentations with 3D scenes, algorithm animations and live code. Decks live as Markdown files on this device or in your Deyslide account, and Claude Code can edit them.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["id.bambanggunawan.deyslide"],
          "appLink": false
        }
      ]
    }
  }
}
