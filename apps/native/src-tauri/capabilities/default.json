{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the app's own pages may use, in the main window and the audience windows: the app's commands, events, the window and the plugins. The http plugin may reach only the Deyslide server, which the app adds when it starts.",
  "windows": ["main", "present-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-destroy",
    "opener:default",
    "dialog:default",
    "os:default",
    "fs:allow-write-file",
    "allow-library-info",
    "allow-library-set-root",
    "allow-library-list",
    "allow-library-create-project",
    "allow-library-rename-project",
    "allow-library-delete-project",
    "allow-library-create-deck",
    "allow-library-rename-deck",
    "allow-library-delete-deck",
    "allow-library-read-deck",
    "allow-library-write-deck",
    "allow-render-respond",
    "allow-render-ready",
    "allow-auth-sign-in",
    "allow-auth-sign-out",
    "allow-auth-access-token",
    "allow-auth-account",
    "allow-mcp-setup",
    "allow-present-open",
    "allow-save-file",
    "allow-app-info",
    "allow-debug-preview-log"
  ]
}
