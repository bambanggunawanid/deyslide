{
  "name": "deyslide",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "A hybrid presentation engine for live teaching and cinematic talks, built on Slidev, TresJS and Motion Canvas.",
  "author": "bambanggunawanid <bambanggunawan887@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/bambanggunawanid/deyslide#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bambanggunawanid/deyslide.git"
  },
  "bugs": {
    "url": "https://github.com/bambanggunawanid/deyslide/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm animations:build && pnpm --filter @deyslide/deck dev",
    "dev:web": "pnpm --filter @deyslide/web dev",
    "dev:server": "pnpm --filter @deyslide/server dev",
    "build": "pnpm animations:build && pnpm --filter @deyslide/deck build && pnpm --filter @deyslide/web build && pnpm --filter @deyslide/server build",
    "export": "pnpm animations:build && pnpm --filter @deyslide/deck export",
    "export:video": "pnpm animations:build && node apps/deck/scripts/export-video.ts",
    "animations:build": "pnpm --filter @deyslide/animations build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p packages/animations/tsconfig.json"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^8.0.0",
    "@anthropic-ai/sdk": "^0.129.0",
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@motion-canvas/player": "^3.17.2",
    "@playwright/test": "1.63.0",
    "@slidev/parser": "53.0.0",
    "@tresjs/cientos": "^5.9.1",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "better-auth": "^1.7.6",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "hono": "^4.13.10",
    "kysely": "^0.29.6",
    "kysely-pglite-dialect": "^1.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.11",
    "yjs": "^13.6.33"
  }
}
