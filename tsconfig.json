{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "node"
    ],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "packages/components/components/**/*.vue",
    "packages/components/src/**/*.ts",
    "packages/components/src/**/*.vue",
    "packages/deck-model/src/**/*.ts",
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.vue",
    "apps/web/*.config.ts",
    "apps/server/src/**/*.ts",
    "apps/server/*.config.ts",
    "apps/deck/scripts/**/*.ts",
    "apps/deck/*.config.ts",
    "features/**/*.ts",
    "*.config.ts"
  ]
}
