# Copy to server.env (never committed). API settings; every one but PUBLIC_URL is optional.
# Leave a sign in option empty and the API hides it.
PUBLIC_URL=https://deyslide.bambanggunawan.id
# Email sign in: a Cloudflare token with Email Sending: Edit
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub reserves the GITHUB_ prefix
GH_OAUTH_CLIENT_ID=
GH_OAUTH_CLIENT_SECRET=
# The deck assistant, and its allowance per account and month in US dollars (default 3)
ANTHROPIC_API_KEY=
ASSISTANT_MONTHLY_LIMIT_USD=
# Media uploads: an R2 API token with Object Read & Write on the bucket (needs CLOUDFLARE_ACCOUNT_ID)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_ACCESS_KEY_SECRET=
R2_BUCKET=deyslide-private-assets
MEDIA_ACCOUNT_LIMIT_MB=
